# In development the request goes through the CRA dev-server proxy
# ("proxy" in package.json -> http://localhost:8080), so it is same-origin
# and the backend does not need CORS enabled.
# Set the absolute URL (http://localhost:8080/api/user) instead if you prefer
# to call the backend directly and it allows the http://localhost:3000 origin.
REACT_APP_API_URL=/api/user
BROWSER=none
